# Simulates an app that sends OTLP logs directly via HTTP
FROM alpine:3.21
RUN apk add --no-cache curl
COPY --chmod=755 <<'EOF' /entrypoint.sh
#!/bin/sh
echo "OTLP app started, sending logs via HTTP every 1 second..."
i=0
while [ $i -lt 20 ]; do
  i=$((i+1))
  # Send a log via OTLP HTTP to the collector
  # OTLP/HTTP uses protobuf-encoded payloads — we can't easily do that from curl
  # Instead, we'll simulate by hitting a known endpoint
  echo "Log entry #$i from otlp-http-app"
  sleep 1
done
echo "Done."
sleep 30
EOF
ENTRYPOINT ["/entrypoint.sh"]
